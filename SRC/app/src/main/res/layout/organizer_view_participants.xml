<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/dashboardEventsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/mainblue"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="24dp"
        android:paddingTop="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Participants"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="24dp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp">

            <LinearLayout
                android:id="@+id/start_end_date_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/greyaccent"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp">
                <TextView
                    android:id="@+id/viewParticipantsTypeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Currently Viewing: Canceled"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="normal"
                    android:textAlignment="center"/>

                <LinearLayout
                    android:id="@+id/filterParticipantBtnContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <Button
                            android:id="@+id/viewCanceledParticipantsBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Canceled"
                            android:textSize="16dp"
                            android:backgroundTint="@color/greybtn"
                            style="@style/SquareButton"
                            android:layout_weight="1"
                            android:textStyle="normal"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="2"/>

                        <Button
                            android:id="@+id/viewWaitingParticipantsBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Waiting"
                            android:textSize="16dp"
                            style="@style/SquareButton"
                            android:backgroundTint="@color/greybtn"
                            android:layout_weight="1"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="2"/>

                        <Button
                            android:id="@+id/viewChosenParticipantsBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Invited"
                            android:textSize="16dp"
                            style="@style/SquareButton"
                            android:backgroundTint="@color/greybtn"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <Button
                        android:id="@+id/viewFinalParticipantsBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="View Final Participants"
                        android:textSize="16dp"
                        android:backgroundTint="@color/bluebtn"
                        style="@style/SquareButton"/>

                    <ListView
                        android:id="@+id/orgParticipantListView"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:background="@color/white"
                        android:layout_marginBottom="8dp"
                        android:padding="4dp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/redrawContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="visible">

                    <Button
                        android:id="@+id/orgRedrawEntrantBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Redraw Canceled participants"
                        android:layout_weight="1"
                        android:backgroundTint="@color/bluebtn"
                        style="@style/SquareButton"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/amountWaitingListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:padding="4dp">


                    <TextView
                        android:id="@+id/waitingListAmt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100"
                        android:textColor="@color/black"
                        android:layout_weight="1"
                        android:textAlignment="textEnd"
                        android:textStyle="bold"
                        android:textSize="18dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Participants Currently In Waiting List:"
                        android:textColor="@color/black"
                        android:layout_weight="1"
                        android:textSize="18dp"/>

                </LinearLayout>

                <TextView
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16dp"
                    android:text="CSV File (Final Participants Only)"
                    android:textColor="@color/black"
                    android:textAlignment="center"/>

                <Button
                    android:id="@+id/createFinalParticipantsCSV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Create CSV file"
                    android:backgroundTint="@color/bluebtn"
                    style="@style/SquareButton"/>

                <Button
                    android:id="@+id/orgViewParticipantsBackToDashboardBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Back"
                    android:backgroundTint="@color/redbtn"
                    style="@style/SquareButton"/>





            </LinearLayout>

            
        </LinearLayout>

